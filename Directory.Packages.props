<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Données -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- SQLite natif corrigé (CVE-2025-6965) : remplace la version 2.1.11 tirée par Microsoft.Data.Sqlite -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Hébergement du service -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Accès Windows -->
    <PackageVersion Include="System.Management" Version="10.0.3" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <!-- Capteurs (MPL-2.0, utilisée sans modification) -->
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
